<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<!-- Remote spec -->
	<remote
		name="github"
		fetch=".."
		review="github.com" />
	<default
		revision="mtesting"
		remote="github"
		sync-j="4"/>

	<!-- Tools -->
	<project path="build/multitool" name="Martinvlba/mvm_build_multitool">
		<linkfile src="multitool.sh" dest="build/multitool.sh" />
	</project>

	<!-- Sources -->
	<project path="source/mvm_manifest" name="Martinvlba/mvm_manifest" />
	<project path="source/mvm" name="Martinvlba/mvm_source_mvm" />
	<project path="source/qemu" name="Martinvlba/mvm_source_qemu" />
</manifest>
